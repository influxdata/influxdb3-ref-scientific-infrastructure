      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT max(uptime_max) AS uptime FROM uptime_5s WHERE host = 'storage' AND time > now() - INTERVAL '10 minutes'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
