# Minimal collectd types.db for the DAQ Telegraf agent.
#
# Telegraf's collectd parser ships no type definitions. Without them a
# multi-value type such as `load` arrives as fields 0/1/2 instead of
# shortterm/midterm/longterm. Only the types this demo receives are listed.
#
# Format: <type>  <dsname>:<dstype>:<min>:<max>[, ...]
percent        value:GAUGE:0:100.1
percent_bytes  value:GAUGE:0:100.1
load           shortterm:GAUGE:0:5000, midterm:GAUGE:0:5000, longterm:GAUGE:0:5000
uptime         value:GAUGE:0:4294967295
if_octets      rx:DERIVE:0:U, tx:DERIVE:0:U
if_packets     rx:DERIVE:0:U, tx:DERIVE:0:U
if_errors      rx:DERIVE:0:U, tx:DERIVE:0:U
