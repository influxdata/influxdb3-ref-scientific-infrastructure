# Required for InfluxDB 3 Enterprise license validation.
# On first `make up`, a validation email is sent to this address; click the
# link in the email to activate your trial. The container will remain in
# "waiting for validation" state until you do.
INFLUXDB3_ENTERPRISE_EMAIL=

# Optional: license type. One of: home, trial, commercial. Default: trial.
# INFLUXDB3_ENTERPRISE_LICENSE_TYPE=trial

# Grafana (the only UI in this repo). Anonymous viewers can open every
# dashboard; the admin login is only needed to edit or to use the HTTP API.
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Storage node chaos. The storage agent runs for STORAGE_UP_S seconds, then
# goes silent for STORAGE_DOWN_S seconds, forever, so the overview's status
# card and the "Node down" alert have something to show (the alert needs
# ~80 s of silence to fire). Set STORAGE_FLAP=false to run it like the others.
STORAGE_FLAP=true
STORAGE_UP_S=180
STORAGE_DOWN_S=120

# Plugin installer (Processing Engine plugins from the public plugin registry)
# REGISTRY_INDEX_URL=https://github.com/influxdata/influxdb3_plugins/releases/download/registry/index.json
# INSTALLER_OFFLINE_DIR=            # directory of pre-downloaded artifacts (air-gapped/CI)
